  <!-- Shared JS -->
  <script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script src="js/shared.js" type="0565298a12523067a4e83476-text/javascript"></script>
  <script type="0565298a12523067a4e83476-text/javascript">
    function openResearchModal() {
      document.getElementById('researchPopupModal').style.display = 'flex';
    }

    function dismissResearchModal() {
      document.getElementById('researchPopupModal').style.display = 'none';
      localStorage.setItem('nc_research_popup_closed', 'true');
    }

    // Intersection Observer for scroll animations & Popup trigger
    document.addEventListener("DOMContentLoaded", function() {
      if (window.location.protocol === 'file:') {
        const container = document.getElementById('videoContainer');
        if (container) {
          container.innerHTML = '<video controls preload="metadata" poster="https://i.ytimg.com/vi/yIb_ZGTuA28/maxresdefault.jpg" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; border-radius: 14px;"><source src="assets/walkthrough.mp4" type="video/mp4">Your browser does not support HTML5 video.</video>';
        }
      }

      if (!localStorage.getItem('nc_research_popup_closed')) {
        setTimeout(() => {
          openResearchModal();
        }, 8000);
      }

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            if (entry.target.classList.contains('stats-grid') && !entry.target.dataset.counted) {
              entry.target.dataset.counted = true;
              document.querySelectorAll('.stat-number').forEach(stat => {
                const target = stat.innerText;
                if (!target.includes('%') && !target.includes('ms') && !target.includes('$')) {
                  const targetNum = parseInt(target, 10);
                  if (!isNaN(targetNum)) {
                    let count = 0;
                    const duration = 2000;
                    const increment = targetNum / (duration / 16);
                    const updateCount = () => {
                      count += increment;
                      if (count < targetNum) {
                        stat.innerText = Math.ceil(count);
                        requestAnimationFrame(updateCount);
                      } else {
                        stat.innerText = targetNum;
                      }
                    };
                    updateCount();
                  }
                }
              });
            }
          }
        });
      }, {
        threshold: 0.1
      });

      document.querySelectorAll('.fade-in-up, .stats-grid').forEach((el) => {
        observer.observe(el);
      });

      if (window.NeuraCryption && window.NeuraCryption.initParticles) {
        window.NeuraCryption.initParticles('hero-canvas');
      }
    });
  </script>
